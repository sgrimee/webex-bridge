#!/usr/bin/env bash
# Build, apply a stable development signature, then run the bridge daemon.
#
# Keychain's “Always Allow” is bound to the caller's code requirement. Cargo
# replaces target/debug/webex-bridged on every rebuild, so its ad-hoc signature
# changes each time. Never start the daemon from an unsigned build.
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

./scripts/sign-bridged-dev
exec "${CARGO_TARGET_DIR:-target}/debug/webex-bridged" "$@"
